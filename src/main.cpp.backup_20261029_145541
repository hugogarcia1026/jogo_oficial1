// ============================================================
// COLISOES SIMPLES DO CENARIO
// ============================================================

bool ColideCirculoRetangulo(float x, float z, float raio,
                            float cx, float cz, float largura, float profundidade) {
    float px = Clamp(x, cx - largura * 0.5f, cx + largura * 0.5f);
    float pz = Clamp(z, cz - profundidade * 0.5f, cz + profundidade * 0.5f);
    float dx = x - px;
    float dz = z - pz;
    return dx * dx + dz * dz < raio * raio;
}

bool PosicaoBloqueada(Vector3 p) {
    const float raio = 0.42f;

    // Colunas, pilares e muralhas principais.
    if (ColideCirculoRetangulo(p.x, p.z, raio, -6.2f, -13.0f, 1.45f, 1.55f)) return true;
    if (ColideCirculoRetangulo(p.x, p.z, raio,  6.2f, -13.0f, 1.45f, 1.55f)) return true;
    if (ColideCirculoRetangulo(p.x, p.z, raio, -9.0f, -7.0f, 1.55f, 1.55f)) return true;
    if (ColideCirculoRetangulo(p.x, p.z, raio,  9.0f, -8.5f, 1.55f, 1.55f)) return true;
    if (ColideCirculoRetangulo(p.x, p.z, raio, -11.5f, -9.5f, 1.35f, 1.35f)) return true;
    if (ColideCirculoRetangulo(p.x, p.z, raio, 11.5f, -11.0f, 1.35f, 1.35f)) return true;

    // Muralhas laterais.
    if (ColideCirculoRetangulo(p.x, p.z, raio, -7.0f, -2.0f, 4.2f, 1.0f)) return true;
    if (ColideCirculoRetangulo(p.x, p.z, raio, 7.0f, -1.0f, 3.6f, 1.2f)) return true;
    if (ColideCirculoRetangulo(p.x, p.z, raio, -14.0f, -4.5f, 3.8f, 1.1f)) return true;
    if (ColideCirculoRetangulo(p.x, p.z, raio, 14.0f, -5.0f, 3.5f, 1.0f)) return true;

    // A estrutura do altar bloqueia a passagem pelas laterais, nao o centro.
    if (ColideCirculoRetangulo(p.x, p.z, raio, -6.2f, -13.0f, 1.45f, 1.55f)) return true;
    return false;
}

void MoverComColisao(Jogador &j, Vector3 deslocamento) {
    Vector3 tentativaX = j.posicao;
    tentativaX.x += deslocamento.x;
    if (!PosicaoBloqueada(tentativaX)) j.posicao.x = tentativaX.x;

    Vector3 tentativaZ = j.posicao;
    tentativaZ.z += deslocamento.z;
    if (!PosicaoBloqueada(tentativaZ)) j.posicao.z = tentativaZ.z;
}

