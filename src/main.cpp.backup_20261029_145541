// ============================================================
// MATEMATICA E UTILIDADES
// ============================================================

Vector3 Suavizar(Vector3 atual, Vector3 destino, float velocidade, float dt) {
    return Vector3Lerp(atual, destino, 1.0f - expf(-velocidade * dt));
}

float SuavizarAngulo(float atual, float destino, float velocidade, float dt) {
    float diferenca = fmodf(destino - atual + 540.0f, 360.0f) - 180.0f;
    return atual + diferenca * (1.0f - expf(-velocidade * dt));
}

float Interpolar(float atual, float destino, float velocidade, float dt) {
    return atual + (destino - atual) * (1.0f - expf(-velocidade * dt));
}

Vector3 Frente(float rotacao) {
    return {
        -sinf(rotacao * DEG2RAD),
        0.0f,
        -cosf(rotacao * DEG2RAD)
    };
}

float DistanciaXZ(Vector3 a, Vector3 b) {
    float dx = a.x - b.x;
    float dz = a.z - b.z;
    return sqrtf(dx * dx + dz * dz);
}

Color CorPainel() {
    return {10, 12, 22, 228};
}

void DesenharPainel(int x, int y, int w, int h) {
    Rectangle r = {
        static_cast<float>(x),
        static_cast<float>(y),
        static_cast<float>(w),
        static_cast<float>(h)
    };

    DrawRectangleRounded(r, 0.12f, 8, CorPainel());
    DrawRectangleRoundedLines(r, 0.12f, 8, {142, 111, 190, 190});
    DrawRectangle(x + 10, y + 12, 3, h - 24, VIOLETA);
}

void DesenharBarra(int x, int y, int largura, int altura,
                   float valor, float maximo, Color cor) {
    DrawRectangleRounded(
        {(float)x, (float)y, (float)largura, (float)altura},
        0.5f, 8, {29, 29, 42, 255}
    );

    float fracao = maximo > 0.0f ? Clamp(valor / maximo, 0.0f, 1.0f) : 0.0f;
    int preenchimento = (int)(largura * fracao);

    if (preenchimento > 0) {
        DrawRectangleRounded(
            {(float)x, (float)y, (float)preenchimento, (float)altura},
            0.5f, 8, cor
        );

        if (preenchimento > 8) {
            DrawRectangle(x + 4, y + 2, preenchimento - 8, 2,
                          Fade(WHITE, 0.30f));
        }
    }
}

