void DesenharMembro(Vector3 junta, float rotacaoY, float rotacaoX,
                    Vector3 deslocamentoLocal, Vector3 tamanho, Color cor) {
    rlPushMatrix();

    rlTranslatef(junta.x, junta.y, junta.z);
    rlRotatef(rotacaoY, 0.0f, 1.0f, 0.0f);
    rlRotatef(rotacaoX, 1.0f, 0.0f, 0.0f);

    rlTranslatef(deslocamentoLocal.x, deslocamentoLocal.y, deslocamentoLocal.z);
    DrawCubeV({0.0f, 0.0f, 0.0f}, tamanho, cor);

    rlPopMatrix();
}

void DesenharJogadorProcedural(const Jogador &j, float tempo) {
    float passo = sinf(j.fasePassos) * j.intensidadeMovimento;
    float passoOposto = sinf(j.fasePassos + PI) * j.intensidadeMovimento;
    float salto = (j.intensidadeMovimento > 0.05f)
        ? fabsf(sinf(j.fasePassos * 2.0f)) * 0.07f * j.intensidadeMovimento
        : 0.0f;

    float respiracao = sinf(tempo * 2.0f) * 0.025f;
    bool esquivando = j.tempoEsquiva > 0.0f;

    Color roupa = esquivando ? Color{83, 43, 129, 255} : Color{34, 48, 77, 255};
    Color roupaClara = esquivando ? Color{139, 87, 193, 255} : Color{54, 73, 112, 255};
    Color pele = {190, 166, 143, 255};

    Vector3 frente = Frente(j.rotacao);
    float x = j.posicao.x;
    float y = j.posicao.y + salto;
    float z = j.posicao.z;
    float troncoY = y + 1.12f + respiracao;

    if (esquivando) {
        for (int i = 1; i <= 4; ++i) {
            float distancia = (float)i * 0.32f;
            Vector3 p = Vector3Subtract(
                j.posicao, Vector3Scale(j.direcaoEsquiva, distancia)
            );

            DrawCubeV({p.x, p.y + 0.95f, p.z}, {0.55f, 1.6f, 0.45f},
                      Color{110, 46, 190, (unsigned char)(100 - i * 18)});
        }
    }

    rlPushMatrix();
    rlTranslatef(x, troncoY, z);
    rlRotatef(j.rotacao, 0.0f, 1.0f, 0.0f);
    rlRotatef(j.inclinacao + (esquivando ? -10.0f : 0.0f), 1.0f, 0.0f, 0.0f);

    DrawCubeV({0, 0, 0}, {0.72f, 1.02f, 0.43f}, roupa);
    DrawCubeV({0, 0.02f, -0.225f}, {0.43f, 0.45f, 0.055f}, roupaClara);
    rlPopMatrix();

    Vector3 ombroE = {x - 0.43f, troncoY + 0.31f, z};
    Vector3 ombroD = {x + 0.43f, troncoY + 0.31f, z};

    DesenharMembro(ombroE, j.rotacao, esquivando ? -32.0f : passoOposto * 28.0f,
                   {0, -0.36f, 0}, {0.23f, 0.76f, 0.26f}, roupaClara);
    DesenharMembro(ombroD, j.rotacao, esquivando ? -32.0f : passo * 28.0f,
                   {0, -0.36f, 0}, {0.23f, 0.76f, 0.26f}, roupaClara);

    DrawSphere({ombroE.x, ombroE.y - 0.77f, ombroE.z}, 0.12f, pele);
    DrawSphere({ombroD.x, ombroD.y - 0.77f, ombroD.z}, 0.12f, pele);

    DrawCubeV({x, y + 0.59f, z}, {0.59f, 0.32f, 0.39f}, DARKGRAY);

    DesenharMembro({x - 0.19f, y + 0.48f, z}, j.rotacao,
                   esquivando ? -18.0f : passo * 30.0f,
                   {0, -0.30f, 0}, {0.25f, 0.60f, 0.27f}, roupa);
    DesenharMembro({x + 0.19f, y + 0.48f, z}, j.rotacao,
                   esquivando ? 18.0f : passoOposto * 30.0f,
                   {0, -0.30f, 0}, {0.25f, 0.60f, 0.27f}, roupa);

    Vector3 peE = Vector3Add({x - 0.19f, y + 0.08f, z}, Vector3Scale(frente, 0.12f));
    Vector3 peD = Vector3Add({x + 0.19f, y + 0.08f, z}, Vector3Scale(frente, 0.12f));

    DrawCubeV(peE, {0.28f, 0.16f, 0.43f}, BLACK);
    DrawCubeV(peD, {0.28f, 0.16f, 0.43f}, BLACK);

    DrawCubeV({x, troncoY + 0.57f, z}, {0.20f, 0.20f, 0.20f}, DARKGRAY);
    Vector3 cabeca = {x, troncoY + 0.87f, z};
    DrawSphere(cabeca, 0.27f, pele);
    DrawSphere({cabeca.x, cabeca.y + 0.10f, cabeca.z + 0.035f}, 0.265f, DARKGRAY);

    DrawCubeV(Vector3Add(cabeca, Vector3Add(Vector3Scale(frente, 0.22f),
               {0, -0.025f, 0})), {0.23f, 0.07f, 0.075f},
               esquivando ? VIOLETA_CLARO : GOLD);

    if (j.tempoAtaque > 0.0f) {
        float progresso = 1.0f - j.tempoAtaque / TEMPO_ATAQUE;
        Vector3 origem = Vector3Add(
            {x, y + 1.2f, z}, Vector3Scale(frente, 0.9f + progresso * 0.7f)
        );
        DrawSphere(origem, 0.13f + 0.08f * sinf(progresso * PI), VIOLETA_CLARO);
    }
}

void DesenharJogador(const Jogador &j, float tempo, const Assets &assets) {
    if (assets.temModeloJogador) {
        DrawModelEx(
            assets.modeloJogador,
            j.posicao,
            {0.0f, 1.0f, 0.0f},
            j.rotacao,
            {1.0f, 1.0f, 1.0f},
            WHITE
        );
    } else {
        DesenharJogadorProcedural(j, tempo);
    }
}

