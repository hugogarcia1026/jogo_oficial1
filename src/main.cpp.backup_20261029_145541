void DesenharColossoProcedural(const Colosso &c, float tempo) {
    Vector3 base = c.posicao;
    float despertar = c.despertado ? 1.0f : 0.0f;
    float respiracao = sinf(tempo * (c.despertado ? 2.0f : 0.8f)) * 0.10f;
    float balanco = c.despertado ? sinf(tempo * 1.3f) * 0.18f : sinf(tempo * 0.35f) * 0.12f;

    Color pedra = c.tempoDano > 0.0f ? Color{160, 94, 103, 255} : Color{82, 77, 74, 255};
    Color escura = {43, 42, 46, 255};
    Color rachadura = c.despertado ? Color{178, 72, 245, 255} : Color{170, 91, 49, 255};
    Color olho = c.despertado ? Color{210, 135, 255, 255} : Color{255, 119, 54, 255};

    DrawCylinder({base.x, 0.02f, base.z}, 4.1f, 4.8f, 0.06f, 24, Fade(BLACK, 0.38f));

    DrawCubeV({base.x - 1.0f, 2.0f, base.z}, {1.4f, 4.0f, 1.6f}, escura);
    DrawCubeV({base.x + 1.0f, 2.0f, base.z}, {1.4f, 4.0f, 1.6f}, escura);
    DrawCubeV({base.x - 1.0f, 0.42f, base.z + 0.3f}, {2.0f, 0.84f, 2.5f}, pedra);
    DrawCubeV({base.x + 1.0f, 0.42f, base.z + 0.3f}, {2.0f, 0.84f, 2.5f}, pedra);

    DrawCubeV({base.x + balanco, 7.0f + respiracao, base.z},
              {4.5f, 6.0f, 2.5f}, pedra);
    DrawCubeWiresV({base.x + balanco, 7.0f + respiracao, base.z},
                   {4.5f, 6.0f, 2.5f}, Fade(escura, 0.8f));

    DrawCubeV({base.x - 3.0f, 9.0f, base.z}, {2.0f, 2.2f, 2.2f}, escura);
    DrawCubeV({base.x + 3.0f, 9.0f, base.z}, {2.0f, 2.2f, 2.2f}, escura);
    DrawCubeV({base.x - 3.1f, 5.9f, base.z + 0.1f}, {1.3f, 4.2f, 1.5f}, pedra);
    DrawCubeV({base.x + 3.1f, 5.9f, base.z + 0.1f}, {1.3f, 4.2f, 1.5f}, pedra);
    DrawCubeV({base.x - 3.1f, 3.7f, base.z + 0.2f}, {1.6f, 1.5f, 1.8f}, escura);
    DrawCubeV({base.x + 3.1f, 3.7f, base.z + 0.2f}, {1.6f, 1.5f, 1.8f}, escura);

    DrawCubeV({base.x, 10.2f, base.z}, {1.6f, 1.5f, 1.6f}, escura);
    DrawCubeV({base.x, 11.5f, base.z - 0.15f}, {2.2f, 2.2f, 2.0f}, pedra);
    DrawCubeV({base.x - 0.9f, 12.7f, base.z}, {0.45f, 1.2f, 0.6f}, escura);
    DrawCubeV({base.x + 0.9f, 12.7f, base.z}, {0.45f, 1.2f, 0.6f}, escura);

    DrawSphere({base.x - 0.48f, 11.65f, base.z - 1.02f}, 0.16f, olho);
    DrawSphere({base.x + 0.48f, 11.65f, base.z - 1.02f}, 0.16f, olho);

    DrawCubeV({base.x, 7.6f, base.z - 1.28f}, {0.22f, 2.0f, 0.08f}, rachadura);
    DrawCubeV({base.x + 0.45f, 7.1f, base.z - 1.29f}, {0.8f, 0.15f, 0.08f}, rachadura);
    DrawCubeV({base.x - 0.4f, 8.0f, base.z - 1.29f}, {0.7f, 0.15f, 0.08f}, rachadura);

    if (c.despertado && !c.derrotado) {
        for (int i = 0; i < 5; ++i) {
            float y = 2.5f + (float)i * 1.6f + sinf(tempo * 2.0f + (float)i) * 0.25f;
            DrawSphere({base.x + sinf(tempo + (float)i) * 2.7f, y,
                        base.z - 1.8f}, 0.10f + 0.04f * sinf(tempo * 3.0f + (float)i),
                       Fade(VIOLETA_CLARO, 0.85f));
        }
    }

    (void)despertar;
}

